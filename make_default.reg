Windows Registry Editor Version 5.00

; --- Registrar UltraExplorer como opción en el menú contextual de carpetas ---
[HKEY_CLASSES_ROOT\Directory\shell\UltraExplorer]
@="Abrir en UltraExplorer"
"Icon"="\"%INSTALL_DIR%\\UltraExplorer.exe\""

[HKEY_CLASSES_ROOT\Directory\shell\UltraExplorer\command]
@="\"%INSTALL_DIR%\\UltraExplorer.exe\" \"%1\""

; --- Registrar UltraExplorer como el gestor PREDETERMINADO de carpetas ---
; ADVERTENCIA: Esto reemplaza la acción de doble clic en Windows Explorer.
; Para activarlo, quita el punto y coma (;) de las siguientes líneas:

; [HKEY_CLASSES_ROOT\Directory\shell\open\command]
; @="\"%INSTALL_DIR%\\UltraExplorer.exe\" \"%1\""

; [HKEY_CLASSES_ROOT\Drive\shell\open\command]
; @="\"%INSTALL_DIR%\\UltraExplorer.exe\" \"%1\""
